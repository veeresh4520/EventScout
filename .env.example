# ===================================================================
# EventScout Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit real secrets or production credentials to source control.
# ===================================================================

# -------------------------------------------------------------------
# MongoDB Configuration
# -------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=eventscout

# -------------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------------
# Secret key used for signing JWT tokens (minimum 32 characters)
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_string_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Initial Development User (Seeded on demand)
# -------------------------------------------------------------------
DEV_USER_USERNAME=sk
DEV_USER_EMAIL=dev@eventscout.local
DEV_USER_PASSWORD=ChangeThisPassword123!

# -------------------------------------------------------------------
# Automation Scheduler Configuration
# -------------------------------------------------------------------
# Interval between automated Meetup scraping runs in hours
SCRAPE_INTERVAL_HOURS=6

# Optional override in minutes for rapid development/testing (e.g. 15)
# SCRAPE_INTERVAL_MINUTES=15

# Daily email digest schedule (in UTC)
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0

# -------------------------------------------------------------------
# Email Provider (SMTP) Configuration
# -------------------------------------------------------------------
# Leave SMTP_HOST empty in local development to safely log digests
# and save HTML previews to data/sent_emails/
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=EventScout <notifications@eventscout.dev>

# -------------------------------------------------------------------
# Frontend API Configuration (used by Next.js)
# -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
 
# Google Gemini AI (Free API from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
