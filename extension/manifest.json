{
  "manifest_version": 3,
  "name": "EventScout — Opportunity Discovery & Clipper",
  "version": "1.0.0",
  "description": "Automatically detects technical hackathons, workshops, and developer meetups on any webpage and saves them to your EventScout dashboard.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EventScout — Event Clipper"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
